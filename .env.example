# 환경 변수 예시. shared/config.py 가 읽는 이름(필드 이름의 대문자)과 기본값입니다.
# 복사해서 `.env` 로 쓰고 비밀 값은 직접 채웁니다. `.env` 는 올리지 않습니다.
# 비워 둔 값 중 DATABASE_URL·ACTIVE_PACKS 는 반드시 채웁니다. 나머지 빈 값은 비워 두어도 됩니다(LLM_BASE_URL 이 비면 LLM 을 안 부름).
# API 키 두 개는 기본값이 `unused` 입니다. 서버가 키를 요구할 때만 바꿉니다(빈 값이면 시작이 실패합니다).

# --- DB (필수) ---
DATABASE_URL=

# --- 앱 시작에 필요 ---
# base 와 업무 팩 하나. 예: base,it_service
ACTIVE_PACKS=

# --- 임베딩(OpenAI 호환 서버) ---
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=nlpai-lab/KURE-v3
EMBED_API_KEY=unused
EMBED_TIMEOUT_S=0.5
EMBED_WARMUP_TIMEOUT_S=3.0
VECTOR_CHANNEL_ENABLED=true

# --- 답변 LLM(OpenAI 호환 서버). 주소가 비면 LLM 을 부르지 않고 원문 발췌로 답합니다 ---
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=unused
LLM_TIMEOUT_S=30.0
LLM_MAX_TOKENS=600
LLM_TEMPERATURE=0.0
LLM_REASONING_EFFORT=none
LLM_MAX_CONCURRENCY=1
LLM_SLOT_WAIT_S=2.0

# --- 검색 ---
KEYWORD_TOP_K=20
VECTOR_TOP_K=20
RRF_K=60
RRF_WEIGHT_KEYWORD=1.0
RRF_WEIGHT_VECTOR=1.0
RRF_WEIGHT_GRAPH=1.0
GRAPH_SEED_DOCS=3
RESULT_TOP_N=20
ONTOLOGY_EXPANSION_ENABLED=false
ONTOLOGY_EXPANSION_MAX_TOKENS=20
DISCOVER_HINT_LIMIT=3
TERM_STATS_REFRESH_S=300.0
SNIPPET_CHARS=200
SNIPPETS_PER_DOC=2
REFERENCE_TEMPLATES_MAX=5
# 아직 켤 수 없는 기능(켜면 앱이 시작하지 않음)
PROXIMITY_BOOST_ENABLED=false
RERANK_ENABLED=false

# --- 규칙 값 ---
INSUFFICIENT_COVERAGE_MIN=0.40
INSUFFICIENT_COSINE_MIN=0.21
INSUFFICIENT_COVERAGE_CHUNKS=10
QA_EVIDENCE_CHUNKS=5
# 비우면 패키지 안 rules/rules.yaml
RULES_PATH=

# --- 앱 ---
DB_CONNECT_TIMEOUT_S=5.0
DB_POOL_SIZE=10
