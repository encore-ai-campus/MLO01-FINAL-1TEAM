{
  "uid": "infra-network",
  "title": "Network Monitoring",
  "description": "FW01 시스템은 FreeBSD Node Exporter, 인터페이스는 SNMPv3를 사용합니다. ifOperStatus 값 1이 UP입니다.",
  "tags": [
    "infrastructure"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "FW01 수집 상태",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "infra-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "infra-prometheus"
          },
          "expr": "monitoring:check_state{check=~\"fw-system|fw-interfaces\"}",
          "legendFormat": "{{server}} · {{check}}",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "데이터 없음",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "-2": {
                  "text": "미구성",
                  "color": "gray"
                },
                "-1": {
                  "text": "데이터 없음",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
