      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "infra-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "infra-prometheus"
          },
          "expr": "sum(ALERTS{alertstate=\"firing\"}) or (0 * sum(monitoring:expected{check=\"prometheus\"} == 1))",
