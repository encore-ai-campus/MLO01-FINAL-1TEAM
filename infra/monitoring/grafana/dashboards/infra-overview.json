{
  "uid": "infra-overview",
  "title": "Infrastructure Overview",
  "description": "서버 상태는 호스트 Exporter 수집 결과입니다. 대시보드의 점검 상태는 실제 수집 결과와 구성 여부를 반영합니다.",
  "tags": [
    "infrastructure"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "인벤토리 서버",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "infra-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "infra-prometheus"
          },
          "expr": "count(count by (server) (monitoring:expected{check=~\"(fw|dc|web|app|pipe|db|mon)-system\"}))",
          "legendFormat": "서버",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "데이터 없음"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
